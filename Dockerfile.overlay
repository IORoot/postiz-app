# Rebuild patched backend, orchestrator and frontend on top of the official
# image. Final size stays close to ghcr.io/gitroomhq/postiz-app:latest
# (~4.8GB), not a from-scratch 9GB build.
FROM ghcr.io/gitroomhq/postiz-app:latest AS build
WORKDIR /app

COPY libraries/nestjs-libraries/src/database/prisma/posts/webhook.payload.ts \
     /app/libraries/nestjs-libraries/src/database/prisma/posts/webhook.payload.ts
COPY libraries/nestjs-libraries/src/database/prisma/posts/posts.repository.ts \
     /app/libraries/nestjs-libraries/src/database/prisma/posts/posts.repository.ts
COPY libraries/nestjs-libraries/src/database/prisma/posts/posts.service.ts \
     /app/libraries/nestjs-libraries/src/database/prisma/posts/posts.service.ts
COPY libraries/nestjs-libraries/src/dtos/posts/bulk.posts.dto.ts \
     /app/libraries/nestjs-libraries/src/dtos/posts/bulk.posts.dto.ts
COPY libraries/nestjs-libraries/src/dtos/media/bulk.delete.media.dto.ts \
     /app/libraries/nestjs-libraries/src/dtos/media/bulk.delete.media.dto.ts
COPY libraries/nestjs-libraries/src/dtos/media/create.media.folder.dto.ts \
     /app/libraries/nestjs-libraries/src/dtos/media/create.media.folder.dto.ts
COPY libraries/nestjs-libraries/src/dtos/media/move.media.dto.ts \
     /app/libraries/nestjs-libraries/src/dtos/media/move.media.dto.ts
COPY libraries/nestjs-libraries/src/dtos/media/rename.media.folder.dto.ts \
     /app/libraries/nestjs-libraries/src/dtos/media/rename.media.folder.dto.ts
COPY libraries/nestjs-libraries/src/database/prisma/schema.prisma \
     /app/libraries/nestjs-libraries/src/database/prisma/schema.prisma
COPY libraries/nestjs-libraries/src/database/prisma/media/media.repository.ts \
     /app/libraries/nestjs-libraries/src/database/prisma/media/media.repository.ts
COPY libraries/nestjs-libraries/src/database/prisma/media/media.service.ts \
     /app/libraries/nestjs-libraries/src/database/prisma/media/media.service.ts
COPY libraries/nestjs-libraries/src/videos \
     /app/libraries/nestjs-libraries/src/videos
COPY libraries/nestjs-libraries/src/upload/custom.upload.validation.ts \
     /app/libraries/nestjs-libraries/src/upload/custom.upload.validation.ts
COPY apps/orchestrator/src/workflows/render.video.edit.workflow.ts \
     /app/apps/orchestrator/src/workflows/render.video.edit.workflow.ts
COPY apps/orchestrator/src/workflows/index.ts \
     /app/apps/orchestrator/src/workflows/index.ts
COPY apps/orchestrator/src/activities/media.activity.ts \
     /app/apps/orchestrator/src/activities/media.activity.ts
COPY apps/backend/src/api/routes/webhooks.controller.ts \
     /app/apps/backend/src/api/routes/webhooks.controller.ts
COPY apps/backend/src/api/routes/posts.controller.ts \
     /app/apps/backend/src/api/routes/posts.controller.ts
COPY apps/backend/src/api/routes/media.controller.ts \
     /app/apps/backend/src/api/routes/media.controller.ts
COPY apps/frontend/src/components/webhooks/webhooks.tsx \
     /app/apps/frontend/src/components/webhooks/webhooks.tsx
COPY apps/frontend/src/components/launches/bulk.actions.tsx \
     /app/apps/frontend/src/components/launches/bulk.actions.tsx
COPY apps/frontend/src/components/launches/calendar.tsx \
     /app/apps/frontend/src/components/launches/calendar.tsx
COPY apps/frontend/src/components/launches/calendar.context.tsx \
     /app/apps/frontend/src/components/launches/calendar.context.tsx
COPY apps/frontend/src/components/launches/filters.tsx \
     /app/apps/frontend/src/components/launches/filters.tsx
COPY apps/frontend/src/components/media/media.component.tsx \
     /app/apps/frontend/src/components/media/media.component.tsx
COPY apps/frontend/src/components/media/media.folders.tsx \
     /app/apps/frontend/src/components/media/media.folders.tsx
COPY apps/frontend/src/components/media/media.bulk.actions.tsx \
     /app/apps/frontend/src/components/media/media.bulk.actions.tsx
COPY apps/frontend/src/components/media/editor \
     /app/apps/frontend/src/components/media/editor
COPY libraries/react-shared-libraries/src/form/checkbox.tsx \
     /app/libraries/react-shared-libraries/src/form/checkbox.tsx
COPY libraries/react-shared-libraries/src/helpers/video.frame.tsx \
     /app/libraries/react-shared-libraries/src/helpers/video.frame.tsx
COPY libraries/react-shared-libraries/src/translation/locales/en/translation.json \
     /app/libraries/react-shared-libraries/src/translation/locales/en/translation.json
COPY libraries/nestjs-libraries/src/integrations/integration.manager.ts \
     /app/libraries/nestjs-libraries/src/integrations/integration.manager.ts
COPY libraries/nestjs-libraries/src/integrations/social/social.integrations.interface.ts \
     /app/libraries/nestjs-libraries/src/integrations/social/social.integrations.interface.ts
COPY libraries/nestjs-libraries/src/integrations/social/webhook.provider.ts \
     /app/libraries/nestjs-libraries/src/integrations/social/webhook.provider.ts
COPY libraries/nestjs-libraries/src/integrations/social/webhook.channel.ts \
     /app/libraries/nestjs-libraries/src/integrations/social/webhook.channel.ts
COPY libraries/nestjs-libraries/src/dtos/posts/providers-settings/all.providers.settings.ts \
     /app/libraries/nestjs-libraries/src/dtos/posts/providers-settings/all.providers.settings.ts
COPY apps/orchestrator/src/activities/post.activity.ts \
     /app/apps/orchestrator/src/activities/post.activity.ts
COPY libraries/nestjs-libraries/src/database/prisma/integrations/integration.service.ts \
     /app/libraries/nestjs-libraries/src/database/prisma/integrations/integration.service.ts
COPY libraries/nestjs-libraries/src/database/prisma/integrations/integration.repository.ts \
     /app/libraries/nestjs-libraries/src/database/prisma/integrations/integration.repository.ts
COPY apps/backend/src/api/routes/integrations.controller.ts \
     /app/apps/backend/src/api/routes/integrations.controller.ts
COPY apps/frontend/src/components/launches/add.provider.component.tsx \
     /app/apps/frontend/src/components/launches/add.provider.component.tsx
COPY apps/frontend/src/components/launches/launches.component.tsx \
     /app/apps/frontend/src/components/launches/launches.component.tsx
COPY apps/frontend/src/components/launches/menu/menu.tsx \
     /app/apps/frontend/src/components/launches/menu/menu.tsx
COPY apps/frontend/src/components/new-launch/providers/show.all.providers.tsx \
     /app/apps/frontend/src/components/new-launch/providers/show.all.providers.tsx
COPY apps/frontend/src/components/new-launch/providers/webhook \
     /app/apps/frontend/src/components/new-launch/providers/webhook
COPY apps/frontend/public/icons/platforms/webhook.png \
     /app/apps/frontend/public/icons/platforms/webhook.png
COPY libraries/nestjs-libraries/src/integrations/social/buffer.provider.ts \
     /app/libraries/nestjs-libraries/src/integrations/social/buffer.provider.ts
COPY apps/frontend/src/components/new-launch/providers/buffer \
     /app/apps/frontend/src/components/new-launch/providers/buffer
COPY apps/frontend/src/components/new-launch/providers/continue-provider/list.tsx \
     /app/apps/frontend/src/components/new-launch/providers/continue-provider/list.tsx
COPY apps/frontend/src/components/new-launch/providers/continue-provider/buffer \
     /app/apps/frontend/src/components/new-launch/providers/continue-provider/buffer
COPY apps/frontend/src/components/launches/continue.integration.tsx \
     /app/apps/frontend/src/components/launches/continue.integration.tsx
COPY apps/frontend/public/icons/platforms/buffer.png \
     /app/apps/frontend/public/icons/platforms/buffer.png
COPY libraries/nestjs-libraries/src/database/prisma/database.module.ts \
     /app/libraries/nestjs-libraries/src/database/prisma/database.module.ts
COPY libraries/nestjs-libraries/src/database/prisma/pipelines \
     /app/libraries/nestjs-libraries/src/database/prisma/pipelines
COPY libraries/nestjs-libraries/src/dtos/pipelines \
     /app/libraries/nestjs-libraries/src/dtos/pipelines
COPY libraries/nestjs-libraries/src/temporal/infinite.workflow.register.ts \
     /app/libraries/nestjs-libraries/src/temporal/infinite.workflow.register.ts
COPY apps/backend/src/api/api.module.ts \
     /app/apps/backend/src/api/api.module.ts
COPY apps/backend/src/api/routes/pipelines.controller.ts \
     /app/apps/backend/src/api/routes/pipelines.controller.ts
COPY apps/orchestrator/src/app.module.ts \
     /app/apps/orchestrator/src/app.module.ts
COPY apps/orchestrator/src/activities/pipeline.activity.ts \
     /app/apps/orchestrator/src/activities/pipeline.activity.ts
COPY apps/orchestrator/src/workflows/pipeline-workflows \
     /app/apps/orchestrator/src/workflows/pipeline-workflows
COPY ["apps/frontend/src/app/(app)/(site)/pipelines", "/app/apps/frontend/src/app/(app)/(site)/pipelines"]
COPY apps/frontend/src/components/pipelines \
     /app/apps/frontend/src/components/pipelines
COPY apps/frontend/src/components/launches/helpers/use.scroll.to.hour.ts \
     /app/apps/frontend/src/components/launches/helpers/use.scroll.to.hour.ts
COPY apps/frontend/src/components/layout/top.menu.tsx \
     /app/apps/frontend/src/components/layout/top.menu.tsx
COPY apps/frontend/src/components/layout/agent.media.modal.tsx \
     /app/apps/frontend/src/components/layout/agent.media.modal.tsx
COPY apps/frontend/src/components/ui/icons/index.tsx \
     /app/apps/frontend/src/components/ui/icons/index.tsx
COPY apps/frontend/src/components/new-launch/last-pipeline.ts \
     /app/apps/frontend/src/components/new-launch/last-pipeline.ts
COPY apps/frontend/src/components/new-launch/manage.modal.tsx \
     /app/apps/frontend/src/components/new-launch/manage.modal.tsx
COPY apps/frontend/src/components/new-launch/picks.socials.component.tsx \
     /app/apps/frontend/src/components/new-launch/picks.socials.component.tsx
COPY apps/frontend/src/components/new-launch/select.current.tsx \
     /app/apps/frontend/src/components/new-launch/select.current.tsx
COPY apps/frontend/src/components/new-launch/store.ts \
     /app/apps/frontend/src/components/new-launch/store.ts

ENV NODE_OPTIONS="--max-old-space-size=4096"
# The folder model is new, so the client in the official image does not know it yet.
RUN DATABASE_URL="postgresql://postiz:postiz@localhost:5432/postiz" pnpm run prisma-generate \
    && pnpm run build:orchestrator && pnpm run build:backend && pnpm run build:frontend

FROM ghcr.io/gitroomhq/postiz-app:latest
LABEL org.opencontainers.image.source="https://github.com/IORoot/postiz-app"
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/apps/orchestrator/dist /app/apps/orchestrator/dist
COPY --from=build /app/apps/backend/dist /app/apps/backend/dist
COPY --from=build /app/apps/frontend/.next /app/apps/frontend/.next
COPY --from=build /app/apps/frontend/src /app/apps/frontend/src
COPY --from=build /app/libraries/nestjs-libraries/src /app/libraries/nestjs-libraries/src
COPY --from=build /app/node_modules/.prisma /app/node_modules/.prisma
COPY --from=build /app/node_modules/@prisma/client /app/node_modules/@prisma/client
COPY --from=build /app/libraries/react-shared-libraries/src /app/libraries/react-shared-libraries/src
COPY --from=build /app/apps/backend/src /app/apps/backend/src
COPY --from=build /app/apps/frontend/public/icons/platforms/webhook.png \
     /app/apps/frontend/public/icons/platforms/webhook.png
COPY --from=build /app/apps/frontend/public/icons/platforms/buffer.png \
     /app/apps/frontend/public/icons/platforms/buffer.png
